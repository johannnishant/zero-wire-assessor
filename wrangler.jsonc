{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"zero-wire-assessor","main":"src/index.js","compatibility_date":"2026-11-18",
  "compatibility_flags":["nodejs_compat"],"preview_urls":false,
  "assets":{"directory":"public","binding":"ASSETS","run_worker_first":true},
  "ai":{"binding":"AI"},
  "durable_objects":{"bindings":[{"name":"LEDGER","class_name":"Ledger"},{"name":"AssessmentAgent","class_name":"AssessmentAgent"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Ledger","AssessmentAgent"]}],
  "workflows":[{"binding":"RUNS","name":"zero-wire-assessments","class_name":"AssessmentWorkflow"}],
  "triggers":{"crons":["*/15 * * * *"]},
  "observability":{"enabled":true,"logs":{"invocation_logs":false}}
}
